@model HospitalManagementSystem.Models.Bill
@{ ViewData["Title"] = "Invoice - " + Model.BillCode; Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><title>Invoice @Model.BillCode</title>
<style>body{font-family:"Segoe UI",sans-serif;padding:24px;background:#f0f2f5;}
.invoice{max-width:750px;margin:0 auto;background:#fff;border-radius:12px;padding:32px;box-shadow:0 4px 20px rgba(0,0,0,.1);}
.inv-header{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #0d6efd;padding-bottom:16px;margin-bottom:20px;}
.hospital-name{font-size:22px;font-weight:800;color:#0d6efd;}
.inv-number{font-size:24px;font-weight:800;color:#0d6efd;}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.charges-table{width:100%;border-collapse:collapse;margin-bottom:20px;}
.charges-table th{background:#f8f9fa;padding:10px;text-align:left;font-size:13px;font-weight:700;border-bottom:2px solid #e9ecef;}
.charges-table td{padding:10px;border-bottom:1px solid #f0f2f5;font-size:14px;}
.total-row td{font-weight:800;font-size:18px;color:#0d6efd;border-top:2px solid #e9ecef;}
.paid-stamp{background:#d4edda;color:#155724;padding:8px 16px;border-radius:8px;font-weight:700;font-size:18px;border:2px dashed #198754;display:inline-block;}
@@media print{.no-print{display:none!important;}body{background:#fff;}}</style>
</head>
<body>
<div class="no-print" style="text-align:right;margin-bottom:16px;"><button onclick="window.print()" style="background:#0d6efd;color:#fff;border:none;padding:8px 18px;border-radius:8px;cursor:pointer;">🖨 Print Invoice</button><a href="/Billing" style="margin-left:8px;color:#6c757d;">← Back</a></div>
<div class="invoice">
<div class="inv-header">
    <div><div class="hospital-name">City General Hospital</div><div style="font-size:12px;color:#6c757d;">Tax Invoice / Payment Receipt</div></div>
    <div style="text-align:right;"><div class="inv-number">@Model.BillCode</div><div style="font-size:12px;color:#6c757d;">Date: @Model.CreatedAt.ToString("dd MMMM yyyy")</div></div>
</div>
<div class="info-grid">
    <div><div style="font-weight:700;margin-bottom:6px;color:#6c757d;font-size:12px;text-transform:uppercase;">Bill To</div><div style="font-size:16px;font-weight:700;">@Model.Patient?.FullName</div><div style="font-size:13px;color:#6c757d;">@Model.Patient?.Phone</div><div style="font-size:13px;color:#6c757d;">@Model.Patient?.PatientCode</div></div>
    <div style="text-align:right;"><div style="font-weight:700;margin-bottom:6px;color:#6c757d;font-size:12px;text-transform:uppercase;">Payment Info</div><div style="font-size:13px;">Method: @(Model.PaymentMethod??"-")</div><div style="font-size:13px;">Status: <strong>@Model.PaymentStatus</strong></div>@if(Model.PaidAt.HasValue){<div style="font-size:13px;">Paid: @Model.PaidAt.Value.ToString("dd MMM yyyy")</div>}</div>
</div>
<table class="charges-table">
    <thead><tr><th>Charge Description</th><th style="text-align:right;">Amount (₹)</th></tr></thead>
    <tbody>
    @if(Model.ConsultationCharge > 0){<tr><td>Consultation Charges</td><td style="text-align:right;">@Model.ConsultationCharge.ToString("N2")</td></tr>}
    @if(Model.RoomCharge > 0){<tr><td>Room/Bed Charges</td><td style="text-align:right;">@Model.RoomCharge.ToString("N2")</td></tr>}
    @if(Model.MedicineCharge > 0){<tr><td>Medicine Charges</td><td style="text-align:right;">@Model.MedicineCharge.ToString("N2")</td></tr>}
    @if(Model.LabCharge > 0){<tr><td>Laboratory Charges</td><td style="text-align:right;">@Model.LabCharge.ToString("N2")</td></tr>}
    @if(Model.RadiologyCharge > 0){<tr><td>Radiology Charges</td><td style="text-align:right;">@Model.RadiologyCharge.ToString("N2")</td></tr>}
    @if(Model.OtherCharges > 0){<tr><td>Other Charges</td><td style="text-align:right;">@Model.OtherCharges.ToString("N2")</td></tr>}
    @if(Model.Discount > 0){<tr><td style="color:green;">Discount (-)</td><td style="text-align:right;color:green;">-@Model.Discount.ToString("N2")</td></tr>}
    @if(Model.Tax > 0){<tr><td>Tax / GST (+)</td><td style="text-align:right;">@Model.Tax.ToString("N2")</td></tr>}
    <tr class="total-row"><td>TOTAL AMOUNT</td><td style="text-align:right;">₹@Model.TotalAmount.ToString("N2")</td></tr>
    </tbody>
</table>
@if(Model.PaymentStatus=="Paid"){<div style="text-align:center;margin:20px 0;"><div class="paid-stamp">✓ PAID IN FULL</div></div>}
@if(!string.IsNullOrEmpty(Model.Notes)){<div style="font-size:13px;color:#6c757d;margin-top:12px;"><strong>Notes:</strong> @Model.Notes</div>}
<div style="margin-top:30px;display:flex;justify-content:space-between;font-size:12px;color:#6c757d;">
<div>This is a computer-generated invoice.</div><div>City General Hospital — Authorized Signature</div>
</div>
</div>
</body></html>
