@model HospitalManagementSystem.ViewModels.BillingDeskViewModel
@{
    ViewData["Title"] = "Billing & Financial Desk";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item active">Billing Desk</li>
            </ol>
        </nav>
        <h1 class="page-title mb-0"><i class="fas fa-file-invoice-dollar text-success me-2"></i>Billing & Accounts Desk</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="/Billing/Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i>New OPD Bill</a>
        <a href="/Billing" class="btn btn-outline-secondary"><i class="fas fa-list me-1"></i>All Invoices</a>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">TODAY'S COLLECTIONS</div>
                        <h3 class="mb-0 fw-bold text-success mt-1">₹@Model.TodayRevenue.ToString("N2")</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="fas fa-rupee-sign fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">PENDING RECEIVABLES</div>
                        <h3 class="mb-0 fw-bold text-warning mt-1">₹@Model.TotalPendingAmount.ToString("N2")</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-danger border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">UNPAID INVOICES</div>
                        <h3 class="mb-0 fw-bold text-danger mt-1">@Model.PendingBills.Count</h3>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                        <i class="fas fa-exclamation-circle fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold">ADMITTED INPATIENTS</div>
                        <h3 class="mb-0 fw-bold text-info mt-1">@Model.ActiveAdmissionsForBilling.Count</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="fas fa-procedures fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Active Inpatients: Automated Discharge Bill Generator -->
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="card-title fw-bold mb-0">
                    <i class="fas fa-bed text-primary me-2"></i>Active Inpatients (Discharge Bill Generator)
                </span>
                <span class="badge bg-primary rounded-pill">@Model.ActiveAdmissionsForBilling.Count Inpatients</span>
            </div>
            <div class="card-body p-0">
                @if (Model.ActiveAdmissionsForBilling.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Admission Code</th>
                                    <th>Patient</th>
                                    <th>Ward / Bed</th>
                                    <th>Admitted Since</th>
                                    <th>Duration</th>
                                    <th>Daily Tariff</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var adm in Model.ActiveAdmissionsForBilling)
                                {
                                    var stayDays = Math.Max(1, (int)(DateTime.Today - adm.AdmissionDate.Date).TotalDays);
                                    <tr>
                                        <td class="fw-bold text-primary">@adm.AdmissionCode</td>
                                        <td>
                                            <div class="fw-semibold">@adm.Patient?.FullName</div>
                                            <div class="small text-muted">@adm.Patient?.PatientCode • @adm.Patient?.Phone</div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@adm.Ward</span>
                                            <span class="fw-semibold ms-1">Bed @(adm.Bed?.BedNumber ?? "-")</span>
                                        </td>
                                        <td>@adm.AdmissionDate.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-info-subtle text-info">@stayDays Day(s)</span></td>
                                        <td class="fw-bold">₹@(adm.Bed?.DailyCharge.ToString("N0") ?? "500")/day</td>
                                        <td class="text-end">
                                            <a href="/Billing/GenerateFromAdmission/@adm.AdmissionId" class="btn btn-sm btn-success">
                                                <i class="fas fa-calculator me-1"></i>Generate Discharge Bill
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                        <p class="mb-0">No active inpatients currently awaiting discharge billing.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Pending Bills Requiring Settlement -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="card-title fw-bold mb-0">
                    <i class="fas fa-hourglass-half text-warning me-2"></i>Pending Bills For Payment
                </span>
                <span class="badge bg-warning text-dark rounded-pill">@Model.PendingBills.Count Pending</span>
            </div>
            <div class="card-body p-0">
                @if (Model.PendingBills.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th>Bill No</th>
                                    <th>Patient</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th class="text-end">Collect Payment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bill in Model.PendingBills)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@bill.BillCode</td>
                                        <td>
                                            <div class="fw-semibold">@bill.Patient?.FullName</div>
                                            <div class="small text-muted">@bill.Patient?.Phone</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-danger">₹@bill.TotalAmount.ToString("N2")</div>
                                            @if (bill.AmountPaid > 0)
                                            {
                                                <div class="small text-muted">Paid: ₹@bill.AmountPaid.ToString("N2")</div>
                                            }
                                        </td>
                                        <td class="small text-muted">@bill.CreatedAt.ToString("dd MMM HH:mm")</td>
                                        <td class="text-end">
                                            <a href="/Billing/Pay/@bill.BillId" class="btn btn-sm btn-outline-success me-1" title="Record Payment">
                                                <i class="fas fa-credit-card me-1"></i>Pay
                                            </a>
                                            <a href="/Billing/Details/@bill.BillId" class="btn btn-sm btn-outline-secondary" title="View Bill Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="fas fa-smile fa-2x text-success mb-2"></i>
                        <p class="mb-0">All current invoices are settled!</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recently Settled Invoices -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <span class="card-title fw-bold mb-0">
                    <i class="fas fa-receipt text-success me-2"></i>Recent Settlements
                </span>
                <span class="badge bg-success rounded-pill">Settled</span>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentPaidBills.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var bill in Model.RecentPaidBills)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-primary">@bill.BillCode</span>
                                        <span class="badge bg-secondary-subtle text-secondary small">@(bill.PaymentMethod ?? "Cash")</span>
                                    </div>
                                    <div class="small fw-semibold text-dark">@bill.Patient?.FullName</div>
                                    <div class="small text-muted">Settled on @(bill.PaidAt?.ToString("dd MMM yyyy HH:mm") ?? bill.CreatedAt.ToString("dd MMM yyyy"))</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success fs-6">₹@bill.AmountPaid.ToString("N2")</div>
                                    <a href="/Billing/Print/@bill.BillId" target="_blank" class="btn btn-link btn-sm text-primary p-0">
                                        <i class="fas fa-print me-1"></i>Receipt
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <p class="mb-0">No paid settlements recorded yet today.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
