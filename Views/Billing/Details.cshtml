@model HospitalManagementSystem.Models.Bill
@{ ViewData["Title"] = "Bill - " + Model.BillCode; }

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Billing">Billing</a></li><li class="breadcrumb-item active">@Model.BillCode</li></ol></nav>
        <h1 class="page-title">Bill Details</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="/Billing/Invoice/@Model.BillId" target="_blank" class="btn btn-outline-primary"><i class="fas fa-file-invoice me-1"></i>View Invoice</a>
        <a href="/Billing" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header"><span class="card-title">Patient Info</span></div>
            <div class="card-body">
                <h5 class="fw-700">@Model.Patient?.FullName</h5>
                <div class="text-muted small mb-2">@Model.Patient?.PatientCode</div>
                <div class="profile-info-item"><span class="profile-info-label">Phone</span><span>@Model.Patient?.Phone</span></div>
                <div class="profile-info-item"><span class="profile-info-label">Blood Group</span><span>@(Model.Patient?.BloodGroup ?? "N/A")</span></div>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><span class="card-title">Payment Status</span></div>
            <div class="card-body text-center">
                <span class="status-badge fs-6 px-3 py-2 @(Model.PaymentStatus == "Paid" ? "badge-paid" : Model.PaymentStatus == "Partial" ? "badge-partial" : "badge-pending")">@Model.PaymentStatus</span>
                <div class="mt-3">
                    <div class="small text-muted">Total Amount</div>
                    <div class="fw-800 fs-3 text-primary">₹@Model.TotalAmount.ToString("N2")</div>
                </div>
                <div class="mt-2">
                    <div class="small text-muted">Amount Paid</div>
                    <div class="fw-700 fs-5 text-success">₹@Model.AmountPaid.ToString("N2")</div>
                </div>
                <hr/>
                <div class="small text-muted">Payment Method: <strong>@(Model.PaymentMethod ?? "Not specified")</strong></div>
                @if (Model.PaidAt.HasValue)
                {
                    <div class="small text-muted">Paid Date: @Model.PaidAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header"><span class="card-title"><i class="fas fa-receipt me-2 text-primary"></i>Breakdown of Charges</span></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table">
                        <thead><tr><th>Service / Item</th><th class="text-end">Amount (₹)</th></tr></thead>
                        <tbody>
                            @if (Model.ConsultationCharge > 0) { <tr><td>Doctor Consultation</td><td class="text-end">@Model.ConsultationCharge.ToString("N2")</td></tr> }
                            @if (Model.RoomCharge > 0) { <tr><td>Room / Ward Charges</td><td class="text-end">@Model.RoomCharge.ToString("N2")</td></tr> }
                            @if (Model.MedicineCharge > 0) { <tr><td>Medicines</td><td class="text-end">@Model.MedicineCharge.ToString("N2")</td></tr> }
                            @if (Model.LabCharge > 0) { <tr><td>Laboratory Tests</td><td class="text-end">@Model.LabCharge.ToString("N2")</td></tr> }
                            @if (Model.RadiologyCharge > 0) { <tr><td>Radiology / Imaging</td><td class="text-end">@Model.RadiologyCharge.ToString("N2")</td></tr> }
                            @if (Model.OtherCharges > 0) { <tr><td>Other Services</td><td class="text-end">@Model.OtherCharges.ToString("N2")</td></tr> }
                            @if (Model.Discount > 0) { <tr class="text-success"><td>Discount</td><td class="text-end">-@Model.Discount.ToString("N2")</td></tr> }
                            @if (Model.Tax > 0) { <tr><td>Tax / GST</td><td class="text-end">@Model.Tax.ToString("N2")</td></tr> }
                            <tr class="fw-800 fs-5">
                                <td>Total</td>
                                <td class="text-end text-primary">₹@Model.TotalAmount.ToString("N2")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
