@model HospitalManagementSystem.Models.Admission
@{ ViewData["Title"] = "Admission Details"; }
<div class="page-header"><div><h1 class="page-title">Admission Details</h1></div><a href="/Admissions" class="btn btn-outline-secondary">Back</a></div>
<div class="card"><div class="card-body">
<div class="row g-3">
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Admission ID</span><span class="fw-600">@Model.AdmissionCode</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Patient</span><span>@Model.Patient?.FullName</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Doctor</span><span>@Model.Doctor?.FullName</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Ward</span><span>@Model.Ward</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Bed</span><span>@Model.Bed?.BedNumber</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Status</span><span class="status-badge @(Model.Status=="Admitted"?"badge-active":"badge-completed")">@Model.Status</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Admission Date</span><span>@Model.AdmissionDate.ToString("dd MMM yyyy")</span></div></div>
    <div class="col-md-4"><div class="profile-info-item"><span class="profile-info-label">Expected Discharge</span><span>@(Model.ExpectedDischargeDate?.ToString("dd MMM yyyy")??"-")</span></div></div>
    <div class="col-12"><strong>Diagnosis:</strong><p>@Model.Diagnosis</p></div>
    @if(!string.IsNullOrEmpty(Model.TreatmentSummary)){<div class="col-12"><strong>Treatment Summary:</strong><p>@Model.TreatmentSummary</p></div>}
</div>
<div class="mt-3 d-flex gap-2">
@if(Model.Status=="Admitted"){<a href="/Admissions/Discharge/@Model.AdmissionId" class="btn btn-danger"><i class="fas fa-sign-out-alt me-2"></i>Discharge Patient</a>}
<a href="/Patients/Details/@Model.PatientId" class="btn btn-outline-primary">View Patient Profile</a>
</div>
</div></div>
