@model IEnumerable<HospitalManagementSystem.Models.Admission>
@{ ViewData["Title"] = "Admissions"; }
<div class="page-header"><div><h1 class="page-title">Admissions</h1><p class="page-subtitle">Currently @ViewBag.Status patients</p></div>
<div class="d-flex gap-2">
<a href="/Admissions?status=Admitted" class="btn @(ViewBag.Status=="Admitted"?"btn-primary":"btn-outline-primary")">Admitted</a>
<a href="/Admissions?status=Discharged" class="btn @(ViewBag.Status=="Discharged"?"btn-primary":"btn-outline-primary")">Discharged</a>
<a href="/Admissions/Create" class="btn btn-success"><i class="fas fa-plus me-2"></i>New Admission</a>
</div></div>
<div class="card"><div class="card-body p-0">
@if(!Model.Any()){<div class="empty-state"><i class="fas fa-procedures"></i><h5>No admissions found</h5></div>}
else{
<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Patient</th><th>Doctor</th><th>Ward/Bed</th><th>Admitted</th><th>Expected Discharge</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var a in Model){<tr>
<td><span class="badge bg-primary-subtle text-primary">@a.AdmissionCode</span></td>
<td class="fw-600">@a.Patient?.FullName</td>
<td>@a.Doctor?.FullName</td>
<td>@a.Ward - @a.Bed?.BedNumber</td>
<td class="small">@a.AdmissionDate.ToString("dd MMM yyyy")</td>
<td class="small">@(a.ExpectedDischargeDate?.ToString("dd MMM yyyy")??"-")</td>
<td><span class="status-badge @(a.Status=="Admitted"?"badge-active":"badge-completed")">@a.Status</span></td>
<td><div class="d-flex gap-1">
<a href="/Admissions/Details/@a.AdmissionId" class="btn btn-sm btn-outline-primary btn-icon"><i class="fas fa-eye"></i></a>
@if(a.Status=="Admitted"){<a href="/Admissions/Discharge/@a.AdmissionId" class="btn btn-sm btn-outline-danger"><i class="fas fa-sign-out-alt me-1"></i>Discharge</a>}
@if(a.Status=="Discharged"){<a href="/Admissions/DischargeSummary/@a.AdmissionId" class="btn btn-sm btn-outline-secondary btn-icon"><i class="fas fa-file-alt"></i></a>}
</div></td>
</tr>}
</tbody></table></div>}
</div></div>
