@model HospitalManagementSystem.ViewModels.AdmissionCreateViewModel
@{ ViewData["Title"] = "New Admission"; }
<div class="page-header"><div><h1 class="page-title">Admit Patient</h1></div></div>
<div class="card"><div class="card-header"><span class="card-title"><i class="fas fa-procedures me-2"></i>Admission Details</span></div><div class="card-body">
<form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Patient *</label><select asp-for="PatientId" class="form-select" required><option value="">-- Select Patient --</option>@foreach(var p in Model.Patients??new List<HospitalManagementSystem.Models.Patient>()){<option value="@p.PatientId">@p.FullName (@p.PatientCode)</option>}</select></div>
<div class="col-md-6"><label class="form-label">Doctor *</label><select asp-for="DoctorId" class="form-select" required><option value="">-- Select Doctor --</option>@foreach(var d in Model.Doctors??new List<HospitalManagementSystem.Models.Doctor>()){<option value="@d.DoctorId">@d.FullName</option>}</select></div>
<div class="col-md-6"><label class="form-label">Available Bed *</label><select asp-for="BedId" class="form-select" required><option value="">-- Select Bed --</option>@foreach(var b in Model.AvailableBeds??new List<HospitalManagementSystem.Models.Bed>()){<option value="@b.BedId">@b.BedNumber - @b.Ward </option>}</select></div>
<div class="col-md-3"><label asp-for="Ward" class="form-label"></label><input asp-for="Ward" class="form-control" placeholder="General, ICU, Private" required/></div>
<div class="col-md-3"><label asp-for="Room" class="form-label"></label><input asp-for="Room" class="form-control" placeholder="Room number"/></div>
<div class="col-md-4"><label asp-for="AdmissionDate" class="form-label"></label><input asp-for="AdmissionDate" type="date" class="form-control" required/></div>
<div class="col-md-4"><label asp-for="ExpectedDischargeDate" class="form-label"></label><input asp-for="ExpectedDischargeDate" type="date" class="form-control"/></div>
<div class="col-12"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" class="form-control" rows="2" required></textarea></div>
</div>
<div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary"><i class="fas fa-procedures me-2"></i>Admit Patient</button><a href="/Admissions" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

