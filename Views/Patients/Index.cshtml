@model HospitalManagementSystem.ViewModels.PatientListViewModel
@{ ViewData["Title"] = "Patients"; }

<div class="page-header">
    <div>
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li><li class="breadcrumb-item active">Patients</li></ol></nav>
        <h1 class="page-title">Patient Management</h1>
        <p class="page-subtitle">@Model.TotalRecords total patients registered</p>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
    {
        <a href="/Patients/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Register Patient</a>
    }
</div>

<!-- Filters -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-600">Search</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search text-muted"></i></span>
                    <input name="search" value="@Model.SearchTerm" class="form-control" placeholder="Name, ID, Phone..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-600">Gender</label>
                <select name="gender" class="form-select">
                    <option value="">All Genders</option>
                    <option value="Male" selected="@(Model.FilterGender == "Male")">Male</option>
                    <option value="Female" selected="@(Model.FilterGender == "Female")">Female</option>
                    <option value="Other" selected="@(Model.FilterGender == "Other")">Other</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-600">Blood Group</label>
                <select name="bloodGroup" class="form-select">
                    <option value="">All</option>
                    @foreach (var bg in new[]{"A+","A-","B+","B-","O+","O-","AB+","AB-"})
                    {
                        <option value="@bg" selected="@(Model.FilterBloodGroup == bg)">@bg</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i>Filter</button>
            </div>
            <div class="col-md-2">
                <a href="/Patients" class="btn btn-outline-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (!Model.Patients.Any())
        {
            <div class="empty-state"><i class="fas fa-user-injured"></i><h5>No patients found</h5><p>Try adjusting your search filters.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr><th>Patient ID</th><th>Name</th><th>Age/Gender</th><th>Phone</th><th>Blood Group</th><th>Reg. Date</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Patients)
                    {
                        <tr>
                            <td><span class="badge bg-primary-subtle text-primary fw-600">@p.PatientCode</span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:32px;height:32px;background:#e8f0fe;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;color:#0d6efd;font-size:12px;flex-shrink:0;">@p.FullName[0]</div>
                                    <div><div class="fw-600 small">@p.FullName</div><div style="font-size:11px;color:#6c757d;">@p.Email</div></div>
                                </div>
                            </td>
                            <td>@p.Age yrs / @p.Gender</td>
                            <td>@p.Phone</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.BloodGroup))
                                {
                                    <span class="badge" style="background:#f8d7da;color:#721c24;font-size:12px;">@p.BloodGroup</span>
                                }
                                else { <span class="text-muted">N/A</span> }
                            </td>
                            <td class="text-muted small">@p.RegistrationDate.ToString("dd MMM yyyy")</td>
                            <td><span class="status-badge @(p.IsActive ? "badge-active" : "badge-inactive")">@(p.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a href="/Patients/Details/@p.PatientId" class="btn btn-sm btn-outline-primary btn-icon" title="View Profile"><i class="fas fa-eye"></i></a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Receptionist"))
                                    {
                                        <a href="/Patients/Edit/@p.PatientId" class="btn btn-sm btn-outline-warning btn-icon" title="Edit"><i class="fas fa-edit"></i></a>
                                        <form method="post" action="/Patients/ToggleStatus/@p.PatientId" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-icon" title="@(p.IsActive ? "Deactivate" : "Activate")" onclick="return confirm('Toggle patient status?')">
                                                <i class="fas @(p.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                    <div class="text-muted small">Showing @((Model.CurrentPage-1)*10+1)–@(Math.Min(Model.CurrentPage*10, Model.TotalRecords)) of @Model.TotalRecords patients</div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="?page=@i&search=@Model.SearchTerm&gender=@Model.FilterGender&bloodGroup=@Model.FilterBloodGroup">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
