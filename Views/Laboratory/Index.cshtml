@model IEnumerable<HospitalManagementSystem.Models.LabTestRequest>
@{ ViewData["Title"] = "Laboratory"; }
<div class="page-header"><div><h1 class="page-title">Laboratory</h1></div>
<div class="d-flex gap-2">
<a href="/Laboratory/Tests" class="btn btn-outline-secondary"><i class="fas fa-list me-1"></i>Test Catalog</a>
<a href="/Laboratory/Request" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Request</a>
</div></div>
<div class="row g-3 mb-3">
    <div class="col-md-4"><div class="stat-card orange"><div class="stat-card-icon orange"><i class="fas fa-hourglass"></i></div><div class="stat-value">@ViewBag.Pending</div><div class="stat-label">Pending</div></div></div>
    <div class="col-md-4"><div class="stat-card blue"><div class="stat-card-icon blue"><i class="fas fa-spinner"></i></div><div class="stat-value">@ViewBag.Processing</div><div class="stat-label">Processing</div></div></div>
    <div class="col-md-4"><div class="stat-card green"><div class="stat-card-icon green"><i class="fas fa-check-circle"></i></div><div class="stat-value">@ViewBag.Completed</div><div class="stat-label">Completed</div></div></div>
</div>
<div class="card mb-3"><div class="card-body py-3"><div class="d-flex gap-2">
    <a href="/Laboratory" class="btn btn-sm @(ViewBag.Status==null?"btn-primary":"btn-outline-primary")">All</a>
    <a href="/Laboratory?status=Requested" class="btn btn-sm @(ViewBag.Status=="Requested"?"btn-primary":"btn-outline-primary")">Requested</a>
    <a href="/Laboratory?status=Processing" class="btn btn-sm @(ViewBag.Status=="Processing"?"btn-primary":"btn-outline-primary")">Processing</a>
    <a href="/Laboratory?status=Completed" class="btn btn-sm @(ViewBag.Status=="Completed"?"btn-primary":"btn-outline-primary")">Completed</a>
</div></div></div>
<div class="card"><div class="card-body p-0">
@if(!Model.Any()){<div class="empty-state"><i class="fas fa-flask"></i><h5>No lab requests</h5></div>}
else{
<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Patient</th><th>Test</th><th>Doctor</th><th>Requested</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var l in Model){<tr>
<td><span class="badge bg-primary-subtle text-primary">@l.RequestCode</span></td>
<td class="fw-600">@l.Patient?.FullName</td>
<td>@l.LabTest?.Name</td>
<td>Dr. @l.Doctor?.FullName</td>
<td class="small">@l.RequestedAt.ToString("dd MMM yyyy")</td>
<td><span class="status-badge @(l.Status=="Completed"?"badge-completed":l.Status=="Processing"?"badge-confirmed":"badge-pending")">@l.Status</span></td>
<td><div class="d-flex gap-1">
@if(l.Status=="Requested"){<form method="post" action="/Laboratory/UpdateStatus/@l.LabTestRequestId">@Html.AntiForgeryToken()<input type="hidden" name="status" value="Processing"/><button type="submit" class="btn btn-sm btn-outline-primary">Process</button></form>}
@if(l.Status=="Processing"){<a href="/Laboratory/EnterResult/@l.LabTestRequestId" class="btn btn-sm btn-outline-success">Enter Result</a>}
@if(l.Status=="Completed"){<a href="/Laboratory/Report/@l.LabTestRequestId" class="btn btn-sm btn-outline-secondary">Report</a>}
</div></td></tr>}
</tbody></table></div>}
</div></div>
