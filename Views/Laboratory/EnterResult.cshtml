@model HospitalManagementSystem.Models.LabTestRequest
@{
    ViewData["Title"] = "Enter Diagnostic Laboratory Result";
}

<div class="page-header mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Laboratory/Workbench">Laboratory Workbench</a></li>
                <li class="breadcrumb-item active">Enter Result</li>
            </ol>
        </nav>
        <h1 class="page-title mb-0"><i class="fas fa-flask text-primary me-2"></i>Diagnostic Result Entry</h1>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <!-- Sample & Patient Summary Card -->
        <div class="card mb-3 border-0 shadow-sm border-start border-primary border-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <div class="small text-muted">Request Code</div>
                        <div class="fw-bold text-primary">@Model.RequestCode</div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="small text-muted">Sample Barcode</div>
                        <div class="fw-bold"><i class="fas fa-barcode me-1 text-secondary"></i>@(Model.SampleBarcode ?? "Pending")</div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="small text-muted">Sample Type</div>
                        <div class="fw-semibold">@(Model.SampleType ?? "Whole Blood")</div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="small text-muted">Patient Name</div>
                        <div class="fw-bold text-dark">@Model.Patient?.FullName</div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="small text-muted">Test Requested</div>
                        <div class="fw-bold text-info-emphasis">@Model.LabTest?.Name</div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="small text-muted">Standard Reference Range</div>
                        <div class="badge bg-light text-dark border">@(Model.LabTest?.NormalRange ?? "Not specified")</div>
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <div class="small text-muted">Ordering Clinician</div>
                        <div class="small fw-semibold">Dr. @(Model.Doctor?.FullName ?? "Hospital Physician")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Result Form -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <span class="card-title fw-bold mb-0"><i class="fas fa-microscope text-primary me-2"></i>Analyzer Value & Clinical Findings</span>
            </div>
            <div class="card-body">
                <form asp-action="EnterResult" asp-route-id="@Model.LabTestRequestId" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold">Test Result / Quantitative Value <span class="text-danger">*</span></label>
                        <textarea name="result" class="form-control" rows="3" required placeholder="Enter exact numerical values, units, or qualitative findings (e.g., Hb: 13.5 g/dL, WBC: 7,200 /uL)...">@Model.Result</textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Reference Range Override (Optional)</label>
                            <input type="text" name="referenceRange" class="form-control" value="@(Model.ReferenceRange ?? Model.LabTest?.NormalRange)" placeholder="e.g. 12.0 - 16.0 g/dL" />
                            <div class="form-text">Defaults to catalog range if unchanged.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Diagnostic Classification Flag</label>
                            <select name="abnormalFlag" class="form-select" id="abnormalFlagSelect">
                                <option value="Normal" selected="@(Model.AbnormalFlag == "Normal" || string.IsNullOrEmpty(Model.AbnormalFlag))">Normal (Within Reference Range)</option>
                                <option value="High" selected="@(Model.AbnormalFlag == "High")">High (Above Normal)</option>
                                <option value="Low" selected="@(Model.AbnormalFlag == "Low")">Low (Below Normal)</option>
                                <option value="Critical" selected="@(Model.AbnormalFlag == "Critical")">Critical / Panic Value (Immediate Doctor Alert)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="isAbnormal" value="true" id="isAbnormalCheck" @(Model.IsAbnormal ? "checked" : "") />
                            <label class="form-check-label fw-semibold text-danger" for="isAbnormalCheck">
                                Mark as Clinically Abnormal Result
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Technician Observations & Methodology Notes</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Sample quality (hemolyzed, lipemic), calibration notes, or method used...">@Model.Notes</textarea>
                    </div>

                    <div class="alert alert-info py-2 small d-flex align-items-center mb-4">
                        <i class="fas fa-shield-alt text-info fs-5 me-2"></i>
                        <div><strong>Quality Control Protocol:</strong> Results entered will move to status <code>Completed</code> and require verification by an authorized Pathologist before being released.</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check-circle me-1"></i>Save & Submit for Verification
                        </button>
                        <a href="/Laboratory/Workbench" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('abnormalFlagSelect').addEventListener('change', function() {
            const check = document.getElementById('isAbnormalCheck');
            if (this.value === 'High' || this.value === 'Low' || this.value === 'Critical') {
                check.checked = true;
            } else {
                check.checked = false;
            }
        });
    </script>
}
