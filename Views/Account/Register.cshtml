@model HospitalManagementSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - City General Hospital</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 40%, #052c65 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        .register-card {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 520px;
            overflow: hidden;
        }
        .register-header {
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
            padding: 32px 36px;
            color: #fff;
            text-align: center;
        }
        .register-body {
            padding: 32px 36px;
        }
    </style>
</head>
<body>
<div class="register-card">
    <div class="register-header">
        <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle mb-3 shadow" style="width:64px;height:64px;">
            <i class="fas fa-user-plus text-primary fs-3"></i>
        </div>
        <h3 class="fw-800 mb-1">Create Account</h3>
        <p class="mb-0 opacity-75 small">City General Hospital Management Portal</p>
    </div>
    <div class="register-body">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger py-2 small mb-3">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-600">Full Name *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" required />
                </div>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-600">Email Address *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="your@email.com" required />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label small fw-600">Phone Number</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-phone text-muted"></i></span>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="9876543210" />
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label small fw-600">Account Type</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Patient">Patient</option>
                        <option value="Doctor">Doctor</option>
                        <option value="Receptionist">Receptionist</option>
                        <option value="Nurse">Nurse</option>
                        <option value="Pharmacist">Pharmacist</option>
                        <option value="LabTechnician">Lab Technician</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-600">Password (min 6 chars, uppercase & special) *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Create strong password" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-600">Confirm Password *</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-check-double text-muted"></i></span>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" required />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg fw-700 mb-3">
                <i class="fas fa-user-check me-2"></i> Register Account
            </button>

            <div class="text-center small text-muted">
                Already have an account? <a href="/Account/Login" class="text-primary fw-600 text-decoration-none">Sign In here</a>
            </div>
        </form>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
