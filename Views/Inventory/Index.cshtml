@model IEnumerable<HospitalManagementSystem.Models.InventoryItem>
@{ ViewData["Title"] = "Inventory"; }
<div class="page-header"><div><h1 class="page-title">Inventory</h1>@if((int)ViewBag.LowStock>0){<span class="badge bg-danger ms-2">@ViewBag.LowStock Low Stock</span>}</div><a href="/Inventory/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Item</a></div>
<div class="card"><div class="card-body p-0">
<div class="table-responsive"><table class="table"><thead><tr><th>Item</th><th>Category</th><th>Quantity</th><th>Min Level</th><th>Unit</th><th>Updated</th><th>Status</th><th>Actions</th></tr></thead><tbody>
@foreach(var i in Model){<tr>
<td class="fw-600">@i.Name</td>
<td><span class="badge bg-light text-dark">@i.Category</span></td>
<td><span class="fw-700 @(i.IsLowStock?"text-danger":"")">@i.Quantity</span> @if(i.IsLowStock){<span class="badge bg-danger">Low!</span>}</td>
<td>@i.MinStockLevel</td>
<td>@i.Unit</td>
<td class="small">@i.LastUpdated.ToString("dd MMM")</td>
<td><span class="status-badge badge-active">Active</span></td>
<td><div class="d-flex gap-1">
<a href="/Inventory/Edit/@i.InventoryItemId" class="btn btn-sm btn-outline-primary btn-icon"><i class="fas fa-edit"></i></a>
<form method="post" action="/Inventory/StockIn/@i.InventoryItemId" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="quantity" value="10"/><button type="submit" class="btn btn-sm btn-outline-success btn-icon" title="Add 10"><i class="fas fa-plus"></i></button></form>
</div></td></tr>}
</tbody></table></div></div></div>


