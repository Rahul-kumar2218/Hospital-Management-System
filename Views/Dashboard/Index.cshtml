@model HospitalManagementSystem.ViewModels.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var monthLabels = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => m.MonthName).ToList());
    var monthData = JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => m.Amount).ToList());
    var deptLabels = JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.DepartmentName).ToList());
    var deptData = JsonSerializer.Serialize(Model.DepartmentStats.Select(d => d.PatientCount).ToList());
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back! Here's what's happening today — @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-600"><i class="fas fa-circle me-1" style="font-size:8px;"></i>System Online</span>
    </div>
</div>

<!-- ===== STAT CARDS ===== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card blue">
            <div class="stat-card-icon blue"><i class="fas fa-user-injured"></i></div>
            <div class="stat-value">@Model.TotalPatients</div>
            <div class="stat-label">Total Patients</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card green">
            <div class="stat-card-icon green"><i class="fas fa-user-md"></i></div>
            <div class="stat-value">@Model.TotalDoctors</div>
            <div class="stat-label">Total Doctors</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card cyan">
            <div class="stat-card-icon cyan"><i class="fas fa-calendar-check"></i></div>
            <div class="stat-value">@Model.TodayAppointments</div>
            <div class="stat-label">Today's Appointments</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card green">
            <div class="stat-card-icon green"><i class="fas fa-bed"></i></div>
            <div class="stat-value">@Model.AvailableBeds <small style="font-size:16px; color:#6c757d;">/ @Model.TotalBeds</small></div>
            <div class="stat-label">Available Beds</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card orange">
            <div class="stat-card-icon orange"><i class="fas fa-file-invoice-dollar"></i></div>
            <div class="stat-value">@Model.PendingBills</div>
            <div class="stat-label">Pending Bills</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card green">
            <div class="stat-card-icon green"><i class="fas fa-rupee-sign"></i></div>
            <div class="stat-value">₹@Model.TodayRevenue.ToString("N0")</div>
            <div class="stat-label">Today's Revenue</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card red">
            <div class="stat-card-icon red"><i class="fas fa-ambulance"></i></div>
            <div class="stat-value">@Model.EmergencyCases</div>
            <div class="stat-label">Emergency Cases</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card orange">
            <div class="stat-card-icon orange"><i class="fas fa-pills"></i></div>
            <div class="stat-value">@Model.LowStockMedicines</div>
            <div class="stat-label">Low Stock Medicines</div>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card h-100">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-chart-line me-2 text-primary"></i>Monthly Revenue</span>
            </div>
            <div class="card-body">
                <div class="chart-container"><canvas id="revenueChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-chart-pie me-2 text-primary"></i>Department Patients</span>
            </div>
            <div class="card-body">
                <div class="chart-container"><canvas id="deptChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

<!-- ===== BED SUMMARY ===== -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-bed me-2 text-primary"></i>Bed Status Overview</span>
                <a href="/Beds" class="btn btn-sm btn-outline-primary">Manage Beds</a>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded-3" style="background:#e8f0fe;">
                            <div style="font-size:32px; font-weight:800; color:#0d6efd;">@Model.TotalBeds</div>
                            <div class="small text-muted">Total Beds</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded-3" style="background:#d4edda;">
                            <div style="font-size:32px; font-weight:800; color:#198754;">@Model.AvailableBeds</div>
                            <div class="small text-muted">Available</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded-3" style="background:#f8d7da;">
                            <div style="font-size:32px; font-weight:800; color:#dc3545;">@Model.OccupiedBeds</div>
                            <div class="small text-muted">Occupied</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 rounded-3" style="background:#fff3cd;">
                            <div style="font-size:32px; font-weight:800; color:#856404;">@(Model.TotalBeds - Model.AvailableBeds - Model.OccupiedBeds)</div>
                            <div class="small text-muted">Reserved/Maintenance</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== TODAY'S APPOINTMENTS & RECENT PATIENTS ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-calendar-day me-2 text-primary"></i>Today's Appointments</span>
                <a href="/Appointments" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.TodayAppointmentsList.Any())
                {
                    <div class="empty-state py-4"><i class="fas fa-calendar-times"></i><h5>No appointments today</h5></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Patient</th><th>Doctor</th><th>Department</th><th>Time</th><th>Status</th></tr></thead>
                            <tbody>
                            @foreach (var apt in Model.TodayAppointmentsList)
                            {
                                <tr>
                                    <td><i class="fas fa-user-circle text-primary me-2"></i>@apt.PatientName</td>
                                    <td>@apt.DoctorName</td>
                                    <td>@apt.Department</td>
                                    <td><span class="badge bg-light text-dark">@apt.Time.ToString(@"hh\:mm")</span></td>
                                    <td>
                                        <span class="status-badge @(apt.Status == "Confirmed" ? "badge-confirmed" : apt.Status == "Completed" ? "badge-completed" : apt.Status == "Cancelled" ? "badge-cancelled" : "badge-pending")">
                                            @apt.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-user-plus me-2 text-primary"></i>Recent Patients</span>
                <a href="/Patients" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @foreach (var p in Model.RecentPatients)
                {
                    <div class="d-flex align-items-center gap-3 p-3 border-bottom">
                        <div style="width:36px;height:36px;background:#e8f0fe;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;color:#0d6efd;font-size:14px;flex-shrink:0;">
                            @p.FullName[0]
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-600 small">@p.FullName</div>
                            <div style="font-size:11px;color:#6c757d;">@p.PatientCode &middot; @(p.BloodGroup ?? "N/A")</div>
                        </div>
                        <a href="/Patients/Details/@p.PatientId" class="btn btn-sm btn-outline-primary btn-icon"><i class="fas fa-eye"></i></a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== RECENT ACTIVITIES ===== -->
<div class="row g-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <span class="card-title"><i class="fas fa-history me-2 text-primary"></i>Recent Activities</span>
                <a href="/Reports/AuditLogs" class="btn btn-sm btn-outline-primary">View Audit Log</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentActivities.Any())
                {
                    <div class="empty-state py-4"><i class="fas fa-clock"></i><h5>No recent activities</h5></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table">
                            <thead><tr><th>Action</th><th>Module</th><th>User</th><th>Time</th></tr></thead>
                            <tbody>
                            @foreach (var a in Model.RecentActivities)
                            {
                                <tr>
                                    <td>@a.Action</td>
                                    <td><span class="badge bg-primary-subtle text-primary">@a.Module</span></td>
                                    <td>@(a.UserName ?? "System")</td>
                                    <td class="text-muted small">@a.Timestamp.ToString("dd MMM, HH:mm")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Revenue Chart
var rCtx = document.getElementById('revenueChart').getContext('2d');
new Chart(rCtx, {
    type: 'line',
    data: {
        labels: @Html.Raw(monthLabels),
        datasets: [{
            label: 'Revenue (₹)',
            data: @Html.Raw(monthData),
            borderColor: '#0d6efd',
            backgroundColor: 'rgba(13,110,253,0.08)',
            borderWidth: 2.5,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#0d6efd',
            pointRadius: 5
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            y: { beginAtZero: true, ticks: { callback: v => '₹' + v.toLocaleString() }, grid: { color: '#f0f2f5' } },
            x: { grid: { display: false } }
        }
    }
});

// Department Chart
var dCtx = document.getElementById('deptChart').getContext('2d');
new Chart(dCtx, {
    type: 'doughnut',
    data: {
        labels: @Html.Raw(deptLabels),
        datasets: [{
            data: @Html.Raw(deptData),
            backgroundColor: ['#0d6efd','#198754','#0dcaf0','#fd7e14','#6f42c1','#dc3545'],
            borderWidth: 2, borderColor: '#fff'
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 12 } } }
    }
});
</script>
}
