@model HospitalManagementSystem.Models.Medicine
@{ ViewData["Title"] = "Add Medicine"; }
<div class="page-header"><div><h1 class="page-title">Add Medicine</h1></div></div>
<div class="card"><div class="card-body">
<form asp-action="Create" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" required/></div>
<div class="col-md-4"><label asp-for="Category" class="form-label"></label><select asp-for="Category" class="form-select"><option value="Tablet">Tablet</option><option value="Capsule">Capsule</option><option value="Syrup">Syrup</option><option value="Injection">Injection</option><option value="Ointment">Ointment</option><option value="Drops">Drops</option></select></div>
<div class="col-md-4"><label asp-for="Supplier" class="form-label"></label><input asp-for="Supplier" class="form-control"/></div>
<div class="col-md-4"><label asp-for="BatchNumber" class="form-label"></label><input asp-for="BatchNumber" class="form-control"/></div>
<div class="col-md-3"><label asp-for="Quantity" class="form-label"></label><input asp-for="Quantity" type="number" class="form-control" min="0" required/></div>
<div class="col-md-3"><label asp-for="Unit" class="form-label"></label><select asp-for="Unit" class="form-select"><option value="Tablet">Tablet</option><option value="Capsule">Capsule</option><option value="Bottle">Bottle</option><option value="Vial">Vial</option></select></div>
<div class="col-md-3"><label asp-for="PurchasePrice" class="form-label"></label><input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" required/></div>
<div class="col-md-3"><label asp-for="SellingPrice" class="form-label"></label><input asp-for="SellingPrice" type="number" step="0.01" class="form-control" required/></div>
<div class="col-md-4"><label asp-for="MinStockLevel" class="form-label"></label><input asp-for="MinStockLevel" type="number" class="form-control"/></div>
<div class="col-md-4"><label asp-for="ExpiryDate" class="form-label"></label><input asp-for="ExpiryDate" type="date" class="form-control"/></div>
<div class="col-md-4"><div class="form-check mt-4"><input asp-for="IsActive" class="form-check-input" type="checkbox" checked/><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
</div>
<div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Add Medicine</button><a href="/Pharmacy" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
