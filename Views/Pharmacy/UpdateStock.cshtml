@model HospitalManagementSystem.Models.Medicine
@{ ViewData["Title"] = "Update Stock"; }
<div class="page-header"><div><h1 class="page-title">Update Stock: @Model.Name</h1></div></div>
<div class="row justify-content-center"><div class="col-md-6">
<div class="card mb-3 border-primary"><div class="card-body text-center">
    <div class="fw-700 fs-4 text-primary">@Model.Quantity</div>
    <div class="text-muted small">Current Stock (@Model.Unit)</div>
    @if(Model.IsLowStock){<span class="badge bg-danger mt-1">LOW STOCK</span>}
</div></div>
<div class="card"><div class="card-body">
<form asp-action="UpdateStock" asp-route-id="@Model.MedicineId" method="post">@Html.AntiForgeryToken()
<div class="mb-3"><label class="form-label fw-600">Transaction Type</label><div class="d-flex gap-3"><label class="form-check-label"><input type="radio" name="type" value="add" checked class="form-check-input me-1"/> Add Stock (Purchase)</label><label class="form-check-label"><input type="radio" name="type" value="subtract" class="form-check-input me-1"/> Remove Stock (Dispense)</label></div></div>
<div class="mb-3"><label class="form-label fw-600">Quantity *</label><input type="number" name="quantity" class="form-control" min="1" required/></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Update Stock</button><a href="/Pharmacy" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div></div>
