@model HospitalManagementSystem.ViewModels.OPDCreateViewModel
@{ ViewData["Title"] = "OPD Registration"; }
<div class="page-header"><div><h1 class="page-title">OPD Registration</h1></div></div>
<div class="row justify-content-center"><div class="col-md-7"><div class="card"><div class="card-header"><span class="card-title"><i class="fas fa-notes-medical me-2"></i>Register OPD Visit</span></div><div class="card-body">
<form asp-action="Register" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="mb-3"><label class="form-label">Patient *</label><select asp-for="PatientId" class="form-select" required><option value="">-- Select Patient --</option>@foreach(var p in Model.Patients??new List<HospitalManagementSystem.Models.Patient>()){<option value="@p.PatientId">@p.FullName (@p.PatientCode)</option>}</select></div>
<div class="mb-3"><label class="form-label">Doctor *</label><select asp-for="DoctorId" class="form-select" required><option value="">-- Select Doctor --</option>@foreach(var d in Model.Doctors??new List<HospitalManagementSystem.Models.Doctor>()){<option value="@d.DoctorId">@d.FullName - @d.Specialization</option>}</select></div>
<div class="mb-3"><label asp-for="ChiefComplaint" class="form-label"></label><textarea asp-for="ChiefComplaint" class="form-control" rows="2"></textarea></div>
<div class="mb-4"><label asp-for="VitalSigns" class="form-label"></label><input asp-for="VitalSigns" class="form-control" placeholder="BP: 120/80, Temp: 98.6F, Pulse: 72" /></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-ticket me-2"></i>Issue Token</button><a href="/OPD" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
