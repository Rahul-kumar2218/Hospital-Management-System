@model HospitalManagementSystem.ViewModels.PrescriptionCreateViewModel
@{ ViewData["Title"] = "New Prescription"; }
<div class="page-header"><div><h1 class="page-title">Create Prescription</h1></div></div>
<div class="card"><div class="card-header"><span class="card-title"><i class="fas fa-file-prescription me-2"></i>Prescription Details</span></div><div class="card-body">
<form asp-action="Create" method="post" id="rxForm">@Html.AntiForgeryToken()
<div asp-validation-summary="All" class="alert alert-danger"></div>
<div class="row g-3 mb-3">
    <div class="col-md-4"><label class="form-label">Patient *</label><select asp-for="PatientId" class="form-select" required><option value="">-- Select --</option>@foreach(var p in Model.Patients??new List<HospitalManagementSystem.Models.Patient>()){<option value="@p.PatientId">@p.FullName (@p.PatientCode)</option>}</select></div>
    <div class="col-md-4"><label class="form-label">Doctor *</label><select asp-for="DoctorId" class="form-select" required><option value="">-- Select --</option>@foreach(var d in Model.Doctors??new List<HospitalManagementSystem.Models.Doctor>()){<option value="@d.DoctorId">@d.FullName</option>}</select></div>
    <div class="col-md-4"><label asp-for="FollowUpDate" class="form-label"></label><input asp-for="FollowUpDate" type="date" class="form-control"/></div>
    <div class="col-12"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" class="form-control" rows="2" required></textarea></div>
    <div class="col-12"><label asp-for="Instructions" class="form-label"></label><textarea asp-for="Instructions" class="form-control" rows="1" placeholder="General instructions..."></textarea></div>
</div>

<div class="card bg-light mb-3">
<div class="card-header d-flex justify-content-between"><strong><i class="fas fa-pills me-2"></i>Medicines</strong><button type="button" class="btn btn-sm btn-primary" onclick="addMedicine()"><i class="fas fa-plus me-1"></i>Add Medicine</button></div>
<div class="card-body" id="medicinesList">
<div class="medicine-row border rounded-3 p-3 mb-2 bg-white" id="med-0">
    <div class="row g-2 align-items-center">
        <div class="col-md-3"><label class="form-label small">Medicine Name *</label><input name="Items[0].MedicineName" class="form-control" required placeholder="e.g. Paracetamol 500mg"/></div>
        <div class="col-md-2"><label class="form-label small">Dosage</label><input name="Items[0].Dosage" class="form-control" placeholder="1 tab"/></div>
        <div class="col-md-2"><label class="form-label small">Frequency</label><select name="Items[0].Frequency" class="form-select"><option>Once daily</option><option>Twice daily</option><option>Three times daily</option><option>Four times daily</option><option>SOS</option></select></div>
        <div class="col-md-2"><label class="form-label small">Duration</label><input name="Items[0].Duration" class="form-control" placeholder="5 days"/></div>
        <div class="col-md-2"><label class="form-label small">Instructions</label><input name="Items[0].Instructions" class="form-control" placeholder="After meals"/></div>
        <div class="col-md-1 pt-4"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeMed(this)"><i class="fas fa-times"></i></button></div>
    </div>
</div>
</div></div>

<div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Prescription</button><a href="/Prescriptions" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
var medCount = 1;
function addMedicine() {
    var list = document.getElementById('medicinesList');
    var div = document.createElement('div');
    div.className = 'medicine-row border rounded-3 p-3 mb-2 bg-white';
    div.id = 'med-' + medCount;
    div.innerHTML = `<div class="row g-2 align-items-center">
        <div class="col-md-3"><label class="form-label small">Medicine Name *</label><input name="Items[${medCount}].MedicineName" class="form-control" required placeholder="e.g. Paracetamol 500mg"/></div>
        <div class="col-md-2"><label class="form-label small">Dosage</label><input name="Items[${medCount}].Dosage" class="form-control" placeholder="1 tab"/></div>
        <div class="col-md-2"><label class="form-label small">Frequency</label><select name="Items[${medCount}].Frequency" class="form-select"><option>Once daily</option><option>Twice daily</option><option>Three times daily</option><option>Four times daily</option><option>SOS</option></select></div>
        <div class="col-md-2"><label class="form-label small">Duration</label><input name="Items[${medCount}].Duration" class="form-control" placeholder="5 days"/></div>
        <div class="col-md-2"><label class="form-label small">Instructions</label><input name="Items[${medCount}].Instructions" class="form-control" placeholder="After meals"/></div>
        <div class="col-md-1 pt-4"><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeMed(this)"><i class="fas fa-times"></i></button></div>
    </div>`;
    list.appendChild(div);
    medCount++;
}
function removeMed(btn) {
    var row = btn.closest('.medicine-row');
    if (document.querySelectorAll('.medicine-row').length > 1) row.remove();
}
</script>
}
