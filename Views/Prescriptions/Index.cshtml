@model IEnumerable<HospitalManagementSystem.Models.Prescription>
@{ ViewData["Title"] = "Prescriptions"; }
<div class="page-header"><div><h1 class="page-title">Prescriptions</h1><p class="page-subtitle">@ViewBag.Total total</p></div><a href="/Prescriptions/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>New Prescription</a></div>
<div class="card"><div class="card-body p-0">
@if(!Model.Any()){<div class="empty-state"><i class="fas fa-file-prescription"></i><h5>No prescriptions found</h5></div>}
else{
<div class="table-responsive"><table class="table"><thead><tr><th>Code</th><th>Patient</th><th>Doctor</th><th>Medicines</th><th>Date</th><th>Actions</th></tr></thead><tbody>
@foreach(var rx in Model){<tr>
<td><span class="badge bg-primary-subtle text-primary">@rx.PrescriptionCode</span></td>
<td class="fw-600">@rx.Patient?.FullName</td>
<td>Dr. @rx.Doctor?.FullName</td>
<td>@rx.Items.Count item(s)</td>
<td class="small">@rx.CreatedAt.ToString("dd MMM yyyy")</td>
<td><div class="d-flex gap-1">
<a href="/Prescriptions/Details/@rx.PrescriptionId" class="btn btn-sm btn-outline-primary btn-icon"><i class="fas fa-eye"></i></a>
<a href="/Prescriptions/Print/@rx.PrescriptionId" target="_blank" class="btn btn-sm btn-outline-secondary btn-icon"><i class="fas fa-print"></i></a>
</div></td></tr>}
</tbody></table></div>}
</div></div>
