@model IEnumerable<HospitalManagementSystem.Models.AuditLog>
@{ ViewData["Title"] = "Audit Logs"; }
<div class="page-header"><div><h1 class="page-title">Audit Logs</h1><p class="page-subtitle">@ViewBag.Total total actions logged</p></div><a href="/Reports" class="btn btn-outline-secondary">Reports</a></div>
<div class="card"><div class="card-body p-0">
<div class="table-responsive"><table class="table"><thead><tr><th>Action</th><th>Module</th><th>User</th><th>IP</th><th>Timestamp</th></tr></thead><tbody>
@foreach(var a in Model){<tr>
<td>@a.Action</td>
<td><span class="badge bg-primary-subtle text-primary">@a.Module</span></td>
<td>@(a.UserName??"-")</td>
<td class="small text-muted">@(a.IPAddress??"-")</td>
<td class="small">@a.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
</tr>}
</tbody></table></div>
@if((int)ViewBag.TotalPages > 1){
<div class="d-flex justify-content-end p-3 border-top"><nav><ul class="pagination pagination-sm mb-0">
@for(int i=1;i<=(int)ViewBag.TotalPages;i++){<li class="page-item @(i==(int)ViewBag.CurrentPage?"active":"")"><a class="page-link" href="?page=@i">@i</a></li>}
</ul></nav></div>}
</div></div>

