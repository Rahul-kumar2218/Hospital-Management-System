@model HospitalManagementSystem.Models.Bed
@{ ViewData["Title"] = "Edit Bed"; }
<div class="page-header"><div><h1 class="page-title">Edit Bed @Model.BedNumber</h1></div></div>
<div class="row justify-content-center"><div class="col-md-6"><div class="card"><div class="card-body">
<form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="BedId" type="hidden"/>
<div class="mb-3"><label asp-for="BedNumber" class="form-label"></label><input asp-for="BedNumber" class="form-control"/></div>
<div class="mb-3"><label asp-for="Ward" class="form-label"></label><select asp-for="Ward" class="form-select"><option value="General">General</option><option value="ICU">ICU</option><option value="Private">Private</option><option value="Emergency">Emergency</option></select></div>
<div class="mb-3"><label asp-for="Ward" class="form-label"></label><select asp-for="Ward" class="form-select"><option value="General">General</option><option value="ICU">ICU</option><option value="Private">Private</option><option value="Semi-Private">Semi-Private</option></select></div>
<div class="mb-3"><label asp-for="DailyCharge" class="form-label"></label><input asp-for="DailyCharge" type="number" step="0.01" class="form-control"/></div>
<div class="mb-3"><div class="form-check"><input asp-for="IsActive" class="form-check-input" type="checkbox"/><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
<div class="d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save</button><a href="/Beds" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

