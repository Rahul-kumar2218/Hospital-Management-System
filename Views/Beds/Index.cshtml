@model IEnumerable<HospitalManagementSystem.Models.Bed>
@{ ViewData["Title"] = "Beds"; }
<div class="page-header"><div><h1 class="page-title">Bed Management</h1></div><a href="/Beds/Create" class="btn btn-primary"><i class="fas fa-plus me-2"></i>Add Bed</a></div>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="stat-card blue"><div class="stat-card-icon blue"><i class="fas fa-bed"></i></div><div class="stat-value">@ViewBag.Total</div><div class="stat-label">Total Beds</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card green"><div class="stat-card-icon green"><i class="fas fa-check"></i></div><div class="stat-value">@ViewBag.Available</div><div class="stat-label">Available</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card red"><div class="stat-card-icon red"><i class="fas fa-user"></i></div><div class="stat-value">@ViewBag.Occupied</div><div class="stat-label">Occupied</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card orange"><div class="stat-card-icon orange"><i class="fas fa-tools"></i></div><div class="stat-value">@(ViewBag.Reserved+ViewBag.Maintenance)</div><div class="stat-label">Reserved/Maint.</div></div></div>
</div>
<div class="card"><div class="card-header"><span class="card-title">Bed Status Grid</span></div><div class="card-body">
<div class="bed-grid">
@foreach(var b in Model){
<div class="bed-card @b.Status.ToLower()">
    <div class="bed-number">@b.BedNumber</div>
    <div class="bed-ward">@b.Ward</div>
    <div class="bed-ward">@b.Ward</div>
    <div class="bed-status-text">@b.Status</div>
    @if(b.Status!="Occupied"){
    <div class="mt-2">
    <form method="post" action="/Beds/UpdateStatus/@b.BedId" class="d-inline">@Html.AntiForgeryToken()
    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
        <option value="Available" selected="@(b.Status=="Available")">Available</option>
        <option value="Reserved" selected="@(b.Status=="Reserved")">Reserved</option>
        <option value="Maintenance" selected="@(b.Status=="Maintenance")">Maintenance</option>
    </select></form>
    </div>}
</div>}
</div>
</div></div>


