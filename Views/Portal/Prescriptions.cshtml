@model List<HospitalManagementSystem.Models.Prescription>
@{
    ViewData["Title"] = "My Prescriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-2">&larr; Back to Portal</a>
        <h2 class="fw-800 mb-1">My Digital Prescriptions</h2>
        <p class="text-muted small mb-0">Authorized prescriptions issued by attending doctors.</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var rx in Model)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 16px;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-700">@rx.PrescriptionCode</span>
                            <h5 class="fw-800 text-dark mt-2 mb-1">@rx.Diagnosis</h5>
                            <div class="small text-muted"><i class="fas fa-user-md me-1 text-primary"></i>@rx.Doctor?.FullName &bull; @rx.Doctor?.Department?.Name</div>
                        </div>
                        <span class="small text-muted">@rx.CreatedAt.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-sm small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine</th>
                                    <th>Dosage</th>
                                    <th>Frequency</th>
                                    <th>Duration</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in rx.Items)
                                {
                                    <tr>
                                        <td class="fw-600">@item.MedicineName</td>
                                        <td>@item.Dosage</td>
                                        <td>@item.Frequency</td>
                                        <td>@item.Duration</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!string.IsNullOrEmpty(rx.Instructions))
                    {
                        <div class="small bg-light p-2 rounded-2 mb-3 text-secondary">
                            <strong>Instructions:</strong> @rx.Instructions
                        </div>
                    }

                    <div class="mt-auto d-flex justify-content-end">
                        <a href="/Prescriptions/Print/@rx.PrescriptionId" target="_blank" class="btn btn-sm btn-outline-success rounded-pill px-3">
                            <i class="fas fa-print me-1"></i> Print Official Rx Slip
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
        <i class="fas fa-prescription-bottle-alt fs-1 mb-3 opacity-50"></i>
        <h5>No Prescriptions Recorded</h5>
        <p class="mb-0">When your doctor writes a digital prescription, it will appear here immediately.</p>
    </div>
}

