@model List<HospitalManagementSystem.Models.Bill>
@{
    ViewData["Title"] = "My Invoices & Payments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3 mb-2">&larr; Back to Portal</a>
        <h2 class="fw-800 mb-1">Billing & Payment Center</h2>
        <p class="text-muted small mb-0">Itemized hospital charges, consultation receipts, and instant settlement.</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var bill in Model)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 p-4" style="border-radius: 16px;">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-700">@bill.BillCode</span>
                            <h4 class="fw-800 text-dark mt-2 mb-0">₹@bill.TotalAmount.ToString("N2")</h4>
                            <small class="text-muted">Issued: @bill.CreatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                        <div>
                            @if (bill.PaymentStatus == "Paid")
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill px-3 py-1 fw-700">
                                    <i class="fas fa-check-circle me-1"></i> PAID
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3 py-1 fw-700">
                                    <i class="fas fa-clock me-1"></i> PENDING
                                </span>
                            }
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-3 mb-3 small">
                        <div class="d-flex justify-content-between mb-1"><span>Consultation:</span><strong>₹@bill.ConsultationCharge.ToString("N2")</strong></div>
                        @if (bill.RoomCharge > 0)
                        {
                            <div class="d-flex justify-content-between mb-1"><span>Room / Ward Tariff:</span><strong>₹@bill.RoomCharge.ToString("N2")</strong></div>
                        }
                        @if (bill.MedicineCharge > 0)
                        {
                            <div class="d-flex justify-content-between mb-1"><span>Pharmacy Medications:</span><strong>₹@bill.MedicineCharge.ToString("N2")</strong></div>
                        }
                        @if (bill.LabCharge > 0)
                        {
                            <div class="d-flex justify-content-between mb-1"><span>Lab Investigations:</span><strong>₹@bill.LabCharge.ToString("N2")</strong></div>
                        }
                        <div class="d-flex justify-content-between pt-2 border-top text-dark fw-700">
                            <span>Total Due:</span><span>₹@bill.TotalAmount.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <a href="/Billing/Invoice/@bill.BillId" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                            <i class="fas fa-print me-1"></i> Print Invoice
                        </a>

                        @if (bill.PaymentStatus != "Paid")
                        {
                            <button type="button" class="btn btn-sm btn-success rounded-pill px-4 fw-700 shadow-sm" data-bs-toggle="modal" data-bs-target="#payModal-@bill.BillId">
                                <i class="fas fa-credit-card me-1"></i> Pay Online
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- PAYMENT MODAL -->
            <div class="modal fade" id="payModal-@bill.BillId" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow" style="border-radius:18px;">
                        <div class="modal-header bg-primary text-white border-0">
                            <h5 class="modal-title fw-700">Pay Invoice @bill.BillCode</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="PayBillOnline" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="billId" value="@bill.BillId" />

                            <div class="modal-body p-4">
                                <div class="text-center mb-4">
                                    <span class="text-muted small">Total Payable Amount</span>
                                    <h2 class="fw-800 text-primary mt-1 mb-0">₹@bill.TotalAmount.ToString("N2")</h2>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small fw-600">Select Payment Gateway / Method</label>
                                    <div class="d-flex flex-column gap-2">
                                        <label class="border rounded-3 p-3 d-flex align-items-center gap-3 cursor-pointer">
                                            <input type="radio" name="paymentMethod" value="UPI" checked />
                                            <i class="fas fa-mobile-alt text-primary fs-4"></i>
                                            <div>
                                                <div class="fw-700">UPI / QR Code Instant Transfer</div>
                                                <small class="text-muted">Google Pay, PhonePe, Paytm, BHIM</small>
                                            </div>
                                        </label>
                                        <label class="border rounded-3 p-3 d-flex align-items-center gap-3 cursor-pointer">
                                            <input type="radio" name="paymentMethod" value="Card" />
                                            <i class="fas fa-credit-card text-success fs-4"></i>
                                            <div>
                                                <div class="fw-700">Credit / Debit Card</div>
                                                <small class="text-muted">Visa, Mastercard, RuPay</small>
                                            </div>
                                        </label>
                                        <label class="border rounded-3 p-3 d-flex align-items-center gap-3 cursor-pointer">
                                            <input type="radio" name="paymentMethod" value="NetBanking" />
                                            <i class="fas fa-university text-warning fs-4"></i>
                                            <div>
                                                <div class="fw-700">Net Banking</div>
                                                <small class="text-muted">All major Indian banks supported</small>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <div class="alert alert-light border small text-muted mb-0">
                                    <i class="fas fa-lock me-1 text-success"></i> 256-bit encrypted secure transaction. Server-side payment reconciliation enabled.
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0">
                                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success rounded-pill px-4 fw-700">Confirm & Complete Payment</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center text-muted" style="border-radius: 16px;">
        <i class="fas fa-receipt fs-1 mb-3 opacity-50"></i>
        <h5>No Invoices Found</h5>
        <p class="mb-0">All your hospital consultation and treatment billing statements will be listed here.</p>
    </div>
}

