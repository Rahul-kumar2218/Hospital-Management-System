@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = "Digital Health Card & QR ID";
    var qrData = $"CITYHOSPITAL:PATIENT:{Model.PatientCode}:TOKEN:{Model.QrToken}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">&larr; Back to Portal</a>
            <span class="text-muted small">&bull; Digital Health Pass (2026 Smart Hospital)</span>
        </div>

        <!-- DIGITAL HEALTH ID CARD -->
        <div class="card border-0 shadow-lg text-white mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #0d6efd 100%); border-radius: 24px; overflow: hidden; position: relative;">
            <div style="position: absolute; right: -40px; bottom: -40px; font-size: 220px; opacity: 0.05; pointer-events: none;">
                <i class="fas fa-hospital-alt"></i>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center border-bottom border-white border-opacity-10 pb-3 mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white rounded-circle p-2 text-primary shadow" style="width:48px;height:48px;display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-plus fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-800 mb-0 tracking-wide">CITY GENERAL HOSPITAL</h5>
                            <small class="opacity-75">National Digital Health Card</small>
                        </div>
                    </div>
                    <span class="badge bg-success px-3 py-1 rounded-pill fw-600"><i class="fas fa-check-circle me-1"></i>ACTIVE</span>
                </div>

                <div class="row align-items-center g-4">
                    <div class="col-sm-7">
                        <div class="text-white-50 small mb-1">PATIENT FULL NAME</div>
                        <h3 class="fw-800 text-white mb-3">@Model.FullName</h3>

                        <div class="row g-2 small">
                            <div class="col-6">
                                <span class="text-white-50 d-block">PATIENT ID</span>
                                <span class="fw-700 fs-6">@Model.PatientCode</span>
                            </div>
                            <div class="col-6">
                                <span class="text-white-50 d-block">BLOOD GROUP</span>
                                <span class="fw-700 fs-6 text-danger bg-white px-2 py-0 rounded">@(Model.BloodGroup ?? "N/A")</span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-white-50 d-block">GENDER / AGE</span>
                                <span class="fw-600">@Model.Gender &middot; @Model.Age Yrs</span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-white-50 d-block">EMERGENCY PHONE</span>
                                <span class="fw-600">@(Model.EmergencyContact ?? Model.Phone)</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Allergies))
                        {
                            <div class="mt-3 p-2 rounded-2 bg-danger bg-opacity-25 border border-danger border-opacity-50 small">
                                <span class="fw-700 text-warning"><i class="fas fa-exclamation-triangle me-1"></i>Allergies:</span> @Model.Allergies
                            </div>
                        }
                    </div>

                    <div class="col-sm-5 text-center">
                        <div class="bg-white p-3 rounded-4 shadow d-inline-block">
                            <!-- Secure QR Code via Google Charts API or Local Canvas -->
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@Uri.EscapeDataString(qrData)" alt="Patient QR Code" class="img-fluid" style="width: 140px; height: 140px;" />
                        </div>
                        <div class="small text-white-50 mt-2" style="font-size:11px;">
                            Scan at kiosk / nursing station
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center text-white-50" style="font-size:11px;">
                    <span>Security Hash: <code>@Model.QrToken</code></span>
                    <span>Issued: @Model.RegistrationDate.ToString("MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 text-center" style="border-radius:18px;">
            <h6 class="fw-700 mb-2"><i class="fas fa-shield-alt text-success me-2"></i>Privacy & DPDP Compliance Note</h6>
            <p class="text-muted small mb-3">
                This QR card contains a cryptographically verified security token. Sensitive clinical diagnoses and medical history are never exposed inside the QR code directly and require authorized clinician login to access.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-outline-primary rounded-pill px-4" onclick="window.print()">
                    <i class="fas fa-print me-1"></i> Print Physical Health Card
                </button>
            </div>
        </div>
    </div>
</div>

