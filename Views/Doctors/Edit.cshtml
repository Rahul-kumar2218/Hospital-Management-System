@model HospitalManagementSystem.Models.Doctor
@{ ViewData["Title"] = "Edit Doctor"; }
<div class="page-header"><div><h1 class="page-title">Edit Doctor: @Model.FullName</h1></div></div>
<div class="card"><div class="card-header"><span class="card-title"><i class="fas fa-edit me-2"></i>Edit Doctor Information</span></div><div class="card-body">
<form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input asp-for="DoctorId" type="hidden"/>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3">
<div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Specialization" class="form-label"></label><input asp-for="Specialization" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="DepartmentId" class="form-label">Department</label><select asp-for="DepartmentId" class="form-select" required><option value="">-- Select --</option>@foreach(var d in ViewBag.Departments as List<HospitalManagementSystem.Models.Department>??new List<HospitalManagementSystem.Models.Department>()){<option value="@d.DepartmentId">@d.Name</option>}</select></div>
<div class="col-md-6"><label asp-for="Qualification" class="form-label"></label><input asp-for="Qualification" class="form-control"/></div>
<div class="col-md-3"><label asp-for="ExperienceYears" class="form-label"></label><input asp-for="ExperienceYears" type="number" class="form-control" min="0"/></div>
<div class="col-md-3"><label asp-for="ConsultationFee" class="form-label"></label><input asp-for="ConsultationFee" type="number" class="form-control" step="0.01"/></div>
<div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" required/></div>
<div class="col-md-6"><label asp-for="AvailableDays" class="form-label"></label><input asp-for="AvailableDays" class="form-control"/></div>
<div class="col-md-6"><label asp-for="AvailableTime" class="form-label"></label><input asp-for="AvailableTime" class="form-control"/></div>
<div class="col-md-3"><label asp-for="IsActive" class="form-label"></label><div class="form-check mt-2"><input asp-for="IsActive" class="form-check-input" type="checkbox"/><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
</div>
<div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Save Changes</button><a href="/Doctors" class="btn btn-outline-secondary">Cancel</a></div>
</form></div></div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
