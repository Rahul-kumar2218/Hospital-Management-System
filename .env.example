# ==============================================================================
# CITY GENERAL HOSPITAL PLATFORM (2026-2030) - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' or configure these keys in appsettings.Production.json
# WARNING: Never commit production secret keys, private certs, or API tokens to git.

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & HOSTING
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (DUAL-STACK SQLITE / SQL SERVER)
# ------------------------------------------------------------------------------
# Default Local SQLite Database:
DB_PROVIDER=Sqlite
ConnectionStrings__DefaultConnection=Data Source=HospitalManagement.db

# Production Microsoft SQL Server Database (Uncomment for production deployments):
# DB_PROVIDER=SqlServer
# ConnectionStrings__DefaultConnection=Server=tcp:hospital-db.database.windows.net,1433;Initial Catalog=CityHospitalProd;Persist Security Info=False;User ID=hospital_admin;Password=YourComplexPassword!2026;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# ------------------------------------------------------------------------------
# 3. IDENTITY, AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=ReplaceWithAStrongSecretKeyAtLeast32CharsLongForHospitalSystem2026!
JWT_ISSUER=CityGeneralHospital
JWT_AUDIENCE=CityHospitalClients
JWT_EXPIRY_MINUTES=60
COOKIE_SECURE_POLICY=Always
SESSION_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATIONS (RAZORPAY / STRIPE / UPI)
# ------------------------------------------------------------------------------
# In Development mode, billing simulations run in test sandbox.
# In Production, server-side signature verification and webhooks are mandatory.
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ------------------------------------------------------------------------------
# 5. COMMUNICATION & NOTIFICATION CHANNELS (EMAIL / SMS / WHATSAPP)
# ------------------------------------------------------------------------------
# SMTP Email Gateway:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.YourSendGridApiKeyHere
SMTP_FROM_EMAIL=notifications@cityhospital.com
SMTP_FROM_NAME="City General Hospital"

# SMS Gateway (Twilio / DLT India Compliant SMS):
SMS_PROVIDER=Twilio
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 6. HEALTHCARE PRIVACY & AUDIT LOGGING
# ------------------------------------------------------------------------------
ENABLE_DETAILED_AUDIT_LOGGING=true
RETENTION_PERIOD_DAYS=365
DPDP_CONSENT_ENABLED=true

